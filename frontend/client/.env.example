# Optional override for Expo Go / a physical phone.
# If unset, native Expo uses the Metro bundler host (your PC's LAN IP) automatically.
# Web always uses http://localhost:4000.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.14:4000

# Dev-only client logs (on automatically in Expo dev builds via __DEV__)
# EXPO_PUBLIC_DEBUG_LOGS=true

# Backend default port is 4000 (see backend/server .env PORT).
# Web browser (same machine): http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical device / Expo Go: same LAN IP as Metro (e.g. http://192.168.1.14:4000)
#
# Backend CORS (CLIENT_ORIGIN) should match the Expo web origin when using web:
# CLIENT_ORIGIN=http://localhost:8081
