{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@sayly/shared": ["../../packages/shared/src/index.ts"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": ["src", "index.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "jest.setup.ts"]
}
