{
  "name": "language-learning-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:shared": "npm --prefix ../../packages/shared run build",
    "predev": "npm run build:shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build:shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "pretypecheck:all": "npm run build:shared",
    "typecheck:all": "tsc -p tsconfig.test.json",
    "pretest": "npm run build:shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "predb:generate": "npm run build:shared",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "predb:studio": "npm run build:shared",
    "db:studio": "drizzle-kit studio",
    "predb:seed": "npm run build:shared",
    "db:seed": "tsx scripts/seed-languages.ts",
    "predb:seed:demo": "npm run build:shared",
    "db:seed:demo": "tsx scripts/seed-demo-users.ts",
    "db:ensure:messaging": "tsx scripts/ensure-messaging-schema.ts",
    "db:ensure:review": "tsx scripts/ensure-review-schema.ts",
    "db:ensure:live": "tsx scripts/ensure-live-schema.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sayly/shared": "file:../../packages/shared",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@vladmandic/face-api": "1.7.15",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "multer": "^2.3.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "redis": "^4.7.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "tinyld": "^1.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  }
}
