                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.url) {",
                  "    try {",
                  "      const parsed = new URL(body.url, pm.environment.get('baseUrl') || 'http://localhost:4000');",
                  "      const parts = parsed.pathname.split('/');",
                  "      const filename = parts[parts.length - 1];",
                  "      if (filename) pm.environment.set('mediaFilename', filename);",
                  "      if (parsed.searchParams.get('exp')) pm.environment.set('mediaExp', parsed.searchParams.get('exp'));",
                  "      if (parsed.searchParams.get('sig')) pm.environment.set('mediaSig', parsed.searchParams.get('sig'));",
                  "    } catch (e) {}",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select an image/audio/video file (max 40 MB)."
                }
              ]
            },
            "url": "{{baseUrl}}/media/uploads",
            "description": "Multipart field `file`. Returns `{ url, mimeType, kind, size }`."
          }
        },
