    {
      "name": "Auth",
      "description": "Public auth + session. Rate-limited. Used by Login, SignUp, Forgot/Reset, apiClient refresh.",
      "item": [
        {
          "name": "POST Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.environment.set('accessToken', body.accessToken);",
                  "  if (body.refreshToken) pm.environment.set('refreshToken', body.refreshToken);",
                  "  if (body.user && body.user.id) pm.environment.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer+{{$timestamp}}@sayly.test\",\n  \"password\": \"SecurePass1\",\n  \"displayName\": \"Reviewer\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Create user + session. Password ≥8 with letter+number. Saves tokens on 201."
          }
