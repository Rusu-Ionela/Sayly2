    {
      "name": "Discovery",
      "description": "Partner feed with match scoring. Used by Discover screen.",
      "item": [
        {
          "name": "GET Discover",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const users = body.items || body.data || body.users || [];",
                  "  if (Array.isArray(users) && users.length > 0) {",
                  "    const first = users[0];",
                  "    const id = first.id || (first.user && first.user.id);",
                  "    if (id) pm.environment.set('partnerUserId', id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/discover?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "discover"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "spokenLanguageId",
                  "value": "en",
                  "disabled": true
                },
                {
                  "key": "learningLanguageId",
                  "value": "ro",
                  "disabled": true
                },
                {
                  "key": "country",
                  "value": "RO",
                  "disabled": true
                },
                {
                  "key": "proficiency",
                  "value": "INTERMEDIATE",
                  "disabled": true
                }
              ]
            },
            "description": "Paginated partner cards. Optional filters: search, spoken/learning language, country, proficiency. Saves first card id to `partnerUserId`."
          }
        },
        {
          "name": "GET Discover User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/discover/users/{{partnerUserId}}",
            "description": "Alias of GET /users/:id/public-profile."
          }
        }
      ]
    },
