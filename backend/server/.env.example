# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:8081

# Dev-only request/auth logs (on by default when NODE_ENV != production)
ENABLE_DEV_LOGS=true

# Database (required). Use DATABASE_URL for the runtime pool.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/language_learning
# Optional dedicated URL for migrations/DDL
DATABASE_MIGRATE_URL=postgresql://postgres:postgres@localhost:5432/language_learning

# JWT / authentication — use long random strings (min 32 chars). Never commit real secrets.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=sayly-api
JWT_AUDIENCE=sayly-client
RESET_CODE_PEPPER=replace-with-a-random-reset-pepper-min-32-chars
# Required in production. Do not reuse JWT_ACCESS_SECRET.
MEDIA_SIGNING_SECRET=replace-with-a-random-media-signing-secret-min-32-chars
# Optional per-user local upload budget (default 500 MB)
# MEDIA_USER_QUOTA_BYTES=524288000

# Redis (required in production). Use redis:// or rediss:// URLs. Do not log these values.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false
REDIS_KEY_PREFIX=sayly
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=2000
# REDIS_USE_MEMORY=false

# Local chat uploads — shared directory for every API process on this machine.
# Separate machines cannot see this disk; do not assume uploads are distributed.
UPLOADS_DIR=./uploads

# Swagger / OpenAPI (enabled by default outside production)
ENABLE_SWAGGER=true
SWAGGER_PATH=/api-docs

# Password reset
PASSWORD_RESET_EXPIRES_IN=5m
APP_RESET_URL=sayly://reset-password

# Optional rate-limit overrides (see SETUP.md)
# LOGIN_RATE_LIMIT_MAX=10
# MESSAGE_SEND_RATE_LIMIT_MAX=120
# AI_USER_CONCURRENCY=2
# AI_GLOBAL_CONCURRENCY=8

# Production mail (required when NODE_ENV=production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Sayly <no-reply@example.com>

# --- Audio/video calls (WebRTC) ---
# STUN is free and enough for many networks. TURN is needed for strict NATs and many mobile carriers:
# run coturn with `use-auth-secret` and put its secret here; clients get short-lived credentials.
ICE_STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Sent to the OpenStreetMap geocoder (Nominatim requires an identifying User-Agent)
GEOCODER_USER_AGENT=Sayly/1.0 (you@example.com)

# --- Chat translation ---
# "mymemory" (default) is free and needs no key, but is limited to 500 characters per message,
# rate limited, and lower quality. For production use "deepl" (free plan: keys end in ":fx")
# or "google" (Cloud Translation Basic v2).
# TRANSLATION_PROVIDER=mymemory
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
# Optional: raises MyMemory's free daily quota.
# MYMEMORY_EMAIL=you@example.com
